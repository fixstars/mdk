Bootstrap: docker
From: nvcr.io/nvidia/pytorch:24.08-py3

%environment
    # OpenMPI enviroments
    export OPAL_PREFIX=/opt/openmpi
    export PATH=/opt/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:$LD_LIBRARY_PATH

    # Optimal NCCL setting
    export NCCL_ALGO=NVLSTree

    # Expose nccl-tests
    export PATH=/opt/nvidia/nccl-tests/build:$PATH

%post
    # Install dependencies
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libibverbs-dev \
        librdmacm-dev \
        flex

    # Install OpenMPI
    git clone https://github.com/open-mpi/ompi.git --recursive -b v5.0.5
    cd ompi
    pip3 install -r docs/requirements.txt
    ./autogen.pl
    mkdir build
    cd build
    ../configure --prefix=/opt/openmpi \
        --with-cuda=/usr/local/cuda \
        --with-ucx=/opt/hpcx/ucx \
        --enable-mca-no-build=btl-uct
    make -j
    make install
    cd ../../
    rm -rf ompi
    # for mpi4py
    export OPAL_PREFIX=/opt/openmpi
    export PATH=/opt/openmpi/bin:$PATH
    export LD_LIBRARY_PATH=/opt/openmpi/lib:$LD_LIBRARY_PATH

    # Install nccl-tests
    cd /opt/nvidia
    git clone https://github.com/NVIDIA/nccl-tests.git
    cd nccl-tests
    make -j MPI=1 MPI_HOME=/opt/openmpi

    # Install Python packages
    pip uninstall -y transformer-engine
    pip install \
        mlflow \
        nltk \
        flask \
        wandb \
        mpi4py \
        tiktoken \
        accelerate \
        transformers>=4.45.0 \
        Flask-RESTful \
        sentencepiece \
        setuptools==68.2.2 \
        git+git://github.com/meta-llama/llama3.git \
        git+https://github.com/NVIDIA/TransformerEngine.git@d2d4cf9142d522562f6e05b2e5768619bd6a1356

    # Install FlashAttention3
    git clone https://github.com/Dao-AILab/flash-attention.git
    cd flash-attention
    git checkout af314d400663fe895199b0586a9f1f718b1d7b79
    cd hopper
    pip install .
    python_path=`python -c "import site; print(site.getsitepackages()[0])"`
    mkdir -p $python_path/flashattn_hopper
    cp flash_attn_interface.py $python_path/flashattn_hopper

    # Install SGD-SAI Optimizer
    pip install sgd-sai
